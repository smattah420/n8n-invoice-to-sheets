    {
      "parameters": {
        "jsCode": "// Parse extracted AI JSON output\nlet extracted = {};\ntry {\n  const rawText = $input.item.json.message.content.replace(/```json|```/g, '').trim();\n  extracted = JSON.parse(rawText);\n} catch (e) {\n  return [{\n    json: {\n      status: 'Rejected - Parsing Failed',\n      reason: 'Failed to parse AI output into JSON',\n      rawOutput: $input.item.json.message.content\n    }\n  }];\n}\n\nconst subtotal = Number(extracted.subtotal || 0);\nconst tax = Number(extracted.tax || 0);\nconst total = Number(extracted.total || 0);\nconst calculatedTotal = Number((subtotal + tax).toFixed(2));\n\n// Validation Rules\nconst isMathValid = Math.abs(calculatedTotal - total) <= 0.05;\nconst missingFields = ['vendor', 'date', 'total'].filter(f => !extracted[f]);\n\nlet status = 'Pending Approval';\nlet isApproved = true;\nlet reason = 'Math & Data Validated Successfully';\n\nif (!isMathValid) {\n  status = 'Flagged - Math Mismatch';\n  isApproved = false;\n  reason = `Subtotal (${subtotal}) + Tax (${tax}) does not match Total (${total})`;\n} else if (missingFields.length > 0) {\n  status = 'Flagged - Missing Fields';\n  isApproved = false;\n  reason = `Missing required fields: ${missingFields.join(', ')}`;\n}\n\nreturn [{\n  json: {\n    invoice_id: extracted.invoice_id || 'N/A',\n    vendor: extracted.vendor || 'Unknown',\n    date: extracted.date || 'N/A',\n    subtotal: subtotal,\n    tax: tax,\n    total: total,\n    status: status,\n    isApproved: isApproved,\n    reason: reason\n  }\n}];"
      },
